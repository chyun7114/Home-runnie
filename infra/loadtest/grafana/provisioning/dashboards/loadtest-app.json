{
  "id": null,
  "uid": "lt-app",
  "title": "Loadtest - App(WebSocket)",
  "tags": ["loadtest", "app", "websocket"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "WS Session p95/p99 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "((histogram_quantile(0.95, sum(rate(ws_session_duration_ms_bucket[1m])) by (le))) unless (sum(rate(ws_session_duration_ms_count[1m])) == 0)) or on() vector(0)",
          "legendFormat": "session p95"
        },
        {
          "expr": "((histogram_quantile(0.99, sum(rate(ws_session_duration_ms_bucket[1m])) by (le))) unless (sum(rate(ws_session_duration_ms_count[1m])) == 0)) or on() vector(0)",
          "legendFormat": "session p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Broker Publish by route/result (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ws_broker_publish_total[1m])) by (route, result)",
          "legendFormat": "{{route}} / {{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "V2 Message result by reason (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ws_v2_message_result_total[1m])) by (result, reason)",
          "legendFormat": "{{result}} / {{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Connected sockets / Active rooms / Pending messages",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(ws_connected_sockets)", "legendFormat": "connected sockets" },
        { "expr": "sum(ws_active_rooms)", "legendFormat": "active rooms" },
        { "expr": "sum(ws_pending_message_jobs)", "legendFormat": "pending msg jobs" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "avg(node_event_loop_lag_ms)", "legendFormat": "event loop lag (avg)" }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" }
}
