{
  "id": null,
  "uid": "lt-container",
  "title": "Loadtest - Container",
  "tags": ["loadtest", "container"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU % by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\", cpu=\"total\"}[1m])) * 100",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Container Memory (working set)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (id) (container_memory_working_set_bytes{id=~\"/docker/.+\"})",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Container Network RX/TX",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (id) (rate(container_network_receive_bytes_total{id=~\"/docker/.+\"}[1m]))",
          "legendFormat": "RX {{id}}"
        },
        {
          "expr": "sum by (id) (rate(container_network_transmit_bytes_total{id=~\"/docker/.+\"}[1m]))",
          "legendFormat": "TX {{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Container Restarts (total)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (id) (changes(container_start_time_seconds{id=~\"/docker/.+\"}[1h]))",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" }
}
