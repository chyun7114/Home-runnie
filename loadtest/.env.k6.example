# k6 WebSocket load test environment
# Copy values into loadtest/.env.k6 (ignored by git)

BACKEND_HTTP_URL=http://backend:3030
ORIGIN=http://localhost:3000
ROOM_ID=1

# Use one token:
ACCESS_TOKEN=

# Or use multiple tokens separated by commas:
ACCESS_TOKENS=

# Optional tuning
THINK_TIME_MS=1000
LEAVE_DELAY_MS=1000
AUTH_TIMEOUT_MS=8000
JOIN_TIMEOUT_MS=8000
MESSAGE_TIMEOUT_MS=8000

# k6 rate scenario tuning
RATE_START=2
RATE_WARMUP_TARGET=5
RATE_TARGET=30
STAGE_WARMUP=1m
STAGE_RAMP=3m
STAGE_SUSTAIN=5m
K6_PREALLOCATED_VUS=50
K6_MAX_VUS=300
